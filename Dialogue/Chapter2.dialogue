	do SceneTransition.change_scene("res://Scene/Chapter2/bedroom1.tscn")
=> END

~ return_living_room
do SceneTransition.change_scene("res://Scene/Chapter2/living_room.tscn")
=> END

~ locked_room
系统: 没有收到命令，先不要进去。
=> END

~ talk_elliot
if GameState.get_flag("cleaner_ask_elliot"):
	if GameState.get_flag("cabinet_open"):
		hal: 门卡为什么能让床底的柜子移出来？
	else:
		hal: 清洁剂在床底，我无法打开那个柜子。
	Elliot: 那是感应卡。刷一下灯控开关旁边的感应器，就能移出自动柜。
	do GameState.set_flag("cleaner_ask_elliot", false)
	=> understand_card
elif GameState.get_flag("flower_task_started"):
	Elliot: 把书房的郁金香搬到花园的空位吧。
else:
	Elliot: 先去打扫卧室吧。
=> END

~ observe_sensor
if GameState.get_flag("card_understood"):
	系统：刷卡即可打开床底的自动柜。
else:
	卧室中的[kw=sensor]。
=> END

~ observe_bed
系统：卧室中的[kw=bed]。
=> END

~ observe_mirror
if GameState.get_flag("mirror_cleaned"):
	思考: 镜子已经擦干净了。
else:
	思考: 镜子很脏，看不清里面的影像。需要浸了清洁剂的抹布。
=> END

~ place_bucket
do Inventory.remove_item("tool_bucket")
do GameState.set_flag("bucket_placed", true)
系统: 已放下清洁工具桶，点击工具桶取出工具。
=> END

~ take_bucket_tool
if not GameState.get_flag("rag_taken"):
	do GameState.set_flag("rag_taken", true)
	do Bedroom.take_tool("rag")
	系统: 已获得抹布。
elif not GameState.get_flag("empty_bottle_taken"):
	do GameState.set_flag("empty_bottle_taken", true)
	do Bedroom.take_tool("empty_bottle")
	思考: 瓶子是空的，需要补充[kw=cleaner]。
else:
	思考: 桶里的工具已经取出了。
=> END

~ research_cleaner
if GameState.get_flag("card_understood") or GameState.get_flag("cleaner_research_chosen"):
	=> END
思考: 清洁剂存放在床底的自动柜中。移动模块不适合钻入，也不方便直接拉开柜子。[next=2]
=> cleaner_dimensions

~ cleaner_dimensions
- 逻辑性：推理感应器与自动柜的关系。 => cleaner_logic
- 发散性：从自动柜的结构寻找使用方法。 => cleaner_exploration
- 社交性：回客厅向 Elliot 询问。 => cleaner_social

~ cleaner_logic
do GameState.set_flag("cleaner_research_chosen", true)
do GameState.set_choice("cleaner_dimension", "logic")
do GameState.add_attribute("logic", 1)
if GameState.get_flag("cabinet_open"):
	思考: 使用逻辑性推断：门卡控制了柜子，说明它实际是通用感应卡。
else:
	思考: 使用逻辑性推断：灯控旁的感应器可能控制自动柜，可以用卡尝试。
=> understand_card

~ cleaner_exploration
do GameState.set_flag("cleaner_research_chosen", true)
do GameState.set_choice("cleaner_dimension", "exploration")
do GameState.add_attribute("exploration", 1)
if GameState.get_flag("cabinet_open"):
	思考: 使用发散性研究：这张卡除了门，还能控制室内其他装置。
else:
	思考: 使用发散性研究：自动柜与灯控旁的感应器相连，试试用卡控制。
=> understand_card

~ cleaner_social
do GameState.set_flag("cleaner_research_chosen", true)
do GameState.set_choice("cleaner_dimension", "social")
do GameState.add_attribute("social", 1)
do GameState.set_flag("cleaner_ask_elliot", true)
if GameState.get_flag("cabinet_open"):
	思考: 使用社交性思考：先回客厅问 Elliot，门卡为什么能操作柜子。
else:
	思考: 使用社交性思考：先回客厅问 Elliot 怎样取出清洁剂。
=> END

~ understand_card
do GameState.set_flag("card_understood", true)
系统: 已理解卡片用途，物品“门卡”更名为“感应卡”。
=> END

~ use_card
if not GameState.get_flag("cabinet_open"):
	do Bedroom.open_cabinet()
	do GameState.set_flag("cabinet_open", true)
	if not GameState.get_flag("card_understood"):
		思考: 门卡竟然把床底的柜子移出来了？需要先弄清原因。
		if GameState.get_flag("cleaner_ask_elliot"):
			思考: 先回客厅询问 Elliot。
		else:
			=> cleaner_dimensions
else:
	思考: 自动柜已经移出并打开。
=> END

~ take_cleaner
if GameState.get_flag("cleaner_taken"):
	=> END
if not GameState.get_flag("card_understood"):
	思考: 先弄清这张卡为什么能操作柜子，再取清洁剂。
	=> END
do GameState.set_flag("cleaner_taken", true)
do Bedroom.take_cleaner()
系统: 已获得袋装清洁剂，可以直接浸湿抹布，也可以倒入空瓶。
=> END

