do Bedroom.clean_mirror()
do Inventory.remove_item("tool_bucket")
do Inventory.remove_item("cleaner_bag")
do Inventory.remove_item("empty_bottle")
do Inventory.remove_item("cleaner_bottle")
do Inventory.remove_item("rag")
do Inventory.remove_item("wet_rag")
do GameState.set_flag("mirror_cleaned", true)
do Bedroom.mirror_closeup()
